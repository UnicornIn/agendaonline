# ============================================================
#  Copia este archivo como .env.local (o .env.production, .env.staging)
#  Todas las variables expuestas al navegador deben empezar por VITE_
# ============================================================

# --- API ---
# Dominio del backend de agenda. Si lo dejas vacío se resuelve por hostname
# (src/config/domains.ts), que en desarrollo es el mismo origen + el proxy.
VITE_API_BASE_URL=https://previewapi.rizosfelices.co
# Prefijo del módulo público de autoagendamiento
VITE_API_PREFIX=/public/agendamiento
# Timeout de cada petición en ms
VITE_API_TIMEOUT_MS=15000
# true = todo el flujo corre sin backend, con los servicios reales de la sede
VITE_USE_MOCKS=true

# --- Router ---
# browser = URLs limpias (requiere rewrite a index.html en el hosting)
# hash    = URLs con #/ (sirve en cualquier hosting estático)
VITE_ROUTER_MODE=browser
# Si la app vive en un subdirectorio, p. ej. /agenda
VITE_ROUTER_BASENAME=/
# Ruta pública de los assets del build (debe coincidir con el basename + "/")
VITE_PUBLIC_BASE=/

# --- Solo desarrollo ---
# Si lo defines, Vite hace proxy de VITE_API_PREFIX a este backend (evita CORS)
VITE_DEV_PROXY_TARGET=

# La sede NO se configura acá: la fija el servidor (AUTOAGENDAMIENTO_SEDE_ID en
# el backend). Un sede_id que venga del navegador es un sede_id que cualquiera
# puede cambiar. Lo mismo el WhatsApp y el abono: salen de GET /config.
