# ============================================================
#  Copia este archivo como .env.local (o .env.production, .env.staging)
#  Todas las variables expuestas al navegador deben empezar por VITE_
# ============================================================

# --- API / dominio ---
# Dominio del backend. Si lo dejas vacío se resuelve por hostname (src/config/domains.js)
VITE_API_BASE_URL=https://api.tudominio.com
# Prefijo común de todos los endpoints
VITE_API_PREFIX=/api/v1
# Timeout de cada petición en ms
VITE_API_TIMEOUT_MS=15000
# true = usa datos simulados (catálogo local, disponibilidad y reservas mock)
VITE_USE_MOCKS=true

# --- Router ---
# browser = URLs limpias (requiere rewrite a index.html en el hosting)
# hash    = URLs con #/ (sirve en cualquier hosting estático)
VITE_ROUTER_MODE=browser
# Si la app vive en un subdirectorio, p. ej. /agenda
VITE_ROUTER_BASENAME=/
# Ruta pública de los assets del build (debe coincidir con el basename + "/")
VITE_PUBLIC_BASE=/

# --- Solo desarrollo ---
# Si lo defines, Vite hace proxy de VITE_API_PREFIX a este backend (evita CORS)
VITE_DEV_PROXY_TARGET=

# --- Negocio ---
VITE_BRANCH_ID=suramericana
VITE_WHATSAPP_NUMBER=573000000000
