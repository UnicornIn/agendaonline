# Desarrollo.
#
# La web ya no trae servicios quemados: el catálogo, las horas, los
# profesionales y el historial salen del backend. Sin uno respondiendo, la
# primera pantalla muestra el error de carga. No es un bug: es que no hay de
# dónde sacar los datos.
#
# Para verla funcionar hay que levantar el backend ANTES:
#
#     cd ../appagenda/Backend
#     venv/Scripts/python run.py
#
# `previewapi.rizosfelices.co` todavía responde 404 en /public/agendamiento:
# el módulo está mergeado pero no desplegado. Cuando lo esté, esta línea puede
# apuntar allá y el backend local deja de hacer falta.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000

# Vacío = mismo origen, o sea el proxy de Vite. Así no hay CORS en desarrollo.
VITE_API_BASE_URL=
VITE_API_PREFIX=/public/agendamiento

# Solo afecta al comprobante y al historial. El catálogo nunca se simula.
VITE_USE_MOCKS=false

VITE_ROUTER_MODE=browser
VITE_ROUTER_BASENAME=/
