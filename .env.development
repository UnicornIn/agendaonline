# Mocks: todo el flujo funciona sin backend, con los servicios reales de la sede.
# Para pegarle al backend de verdad: VITE_USE_MOCKS=false y descomentar el proxy.
VITE_API_BASE_URL=
VITE_API_PREFIX=/public/agendamiento
VITE_USE_MOCKS=true
VITE_ROUTER_MODE=browser
VITE_ROUTER_BASENAME=/
# Con el proxy, /public/agendamiento viaja al backend sin problemas de CORS
# VITE_DEV_PROXY_TARGET=https://previewapi.rizosfelices.co
VITE_DEV_PROXY_TARGET=
