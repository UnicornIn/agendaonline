# Desarrollo. La web YA NO trae servicios quemados: el catálogo, las horas y
# los profesionales salen del backend, así que `npm run dev` necesita uno
# corriendo o la primera pantalla muestra el error de carga.
#
# Con el backend local:
#     cd ../appagenda/Backend && venv/Scripts/python run.py
#
# El proxy evita el CORS: /public/agendamiento viaja al backend desde el mismo
# origen que la web.
VITE_API_BASE_URL=
VITE_API_PREFIX=/public/agendamiento
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000

# Solo afecta al comprobante y al historial. El catálogo nunca se simula.
VITE_USE_MOCKS=false

VITE_ROUTER_MODE=browser
VITE_ROUTER_BASENAME=/
