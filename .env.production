# Dominio del backend de agenda (el módulo público de autoagendamiento)
VITE_API_BASE_URL=https://previewapi.rizosfelices.co
VITE_API_PREFIX=/public/agendamiento
VITE_USE_MOCKS=false
VITE_ROUTER_MODE=browser
VITE_ROUTER_BASENAME=/
VITE_PUBLIC_BASE=/

# Píxel de Meta (cuenta Rizos Felices). Solo en producción: así las pruebas
# del equipo no entran a los informes de la cuenta de anuncios.
VITE_META_PIXEL_ID=1405371181642634

# Quienes cortan con maquina, por sede: apodo:ID,ID;otra-sede:ID
# Vacio = la pregunta "tijera o maquina" no aparece. Llenar cuando operacion
# confirme quienes usan maquina en cada sede.
VITE_PROFESIONALES_MAQUINA=suramericana:ES-73238,ES-32141
